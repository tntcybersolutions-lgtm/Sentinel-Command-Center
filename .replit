modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["p7zip", "unzip", "jq", "gh"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5099
externalPort = 3001

[[ports]]
localPort = 24678
externalPort = 3000

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
# Autoscale allows the container a limited window to open port 5000 before it
# declares "the required port was never opened". Installing packages inside that
# window spends it on work the build step already did: `npm run build` runs with
# the full dependency tree, and the resulting filesystem is what the container
# boots from, so node_modules is normally already present.
#
# So probe first and only install when something is genuinely missing. express is
# a good canary — the server bundle marks most packages external and cannot start
# without it. When node_modules is intact this costs milliseconds instead of
# minutes; when it is not, the old install still runs and nothing is lost.
#
# --omit=optional on the fallback: @tailwindcss/oxide ships per-platform binaries
# as optional dependencies, including @tailwindcss/oxide-wasm32-wasi. Replit's
# package firewall returns 404 for that tarball and npm treats the failed fetch
# as a hard error rather than skipping an optional package. Tailwind is a
# build-time tool the server bundle never loads.
#
# ';' rather than '&&' before node: a failed install must not stop the server
# from starting. With '&&' the port is never opened and the deploy reports only
# "the required port was never opened", with no indication npm was the problem.
  run = ["sh", "-c", "node -e \"require.resolve('express')\" 2>/dev/null || npm install --omit=dev --omit=optional --no-audit --no-fund; node ./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_database:1.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_object_storage:2.0.0"]

[userenv]

[userenv.shared]
# EGNYTE_CLIENT_ID and EGNYTE_CLIENT_SECRET moved to Replit Secrets.
# Rotate the secret at the Egnyte provider first — the previously
# committed value must be treated as compromised.
EGNYTE_DOMAIN = "tntcyber"
HIGHERGOV_BASE_URL = "https://www.highergov.com"

[userenv.development]
VITE_HMR_OVERLAY = "false"

[objectStorage]
defaultBucketID = "replit-objstore-c6fe9ea2-c700-4765-b89e-6724876a539d"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
